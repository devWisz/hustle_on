# Dependencies
node_modules/
.pnp/
.yarn/

# Builds
dist/
build/
.next/
out/
bin/
target/
*.exe

# Environment
.env
.env.*
!.env.example

# Secrets and keys
*.pem
*.key
keypairs/
.anchor/
test-ledger/

# The deployed program's upgrade authority. It lives here as well as under
# contracts/target/ because `anchor clean` deletes target/ — and losing this
# keypair means the program can never be upgraded, only abandoned.
contracts/.keys/

# Tooling
.DS_Store
coverage/
*.log
.turbo/
.vercel/
.idea/
.vscode/*
!.vscode/extensions.json

# Go
vendor/
*.test
.neon

# Local development object storage. When no bucket is configured the API writes
# real uploads here, so committing it would put somebody's recording — and every
# poster an operator picks — into the repository.
backend/data/

# TypeScript's incremental build cache. It changes on every build, so tracking it
# means a diff on every build that says nothing about the code.
frontend/tsconfig.tsbuildinfo
# Local build cache, used when the machine's default cache is not writable.
.gocache/

# Operator access details. Generated by scripts/write-admin-access.sh and
# deliberately excluded: it is a single page listing every credential the
# deployment has, which is exactly the file that must never be committed.
ADMIN-ACCESS.md
