# ---------------------------------------------------------------------------
# Hustle On environment. Copy to .env and fill in. Never commit the filled file.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=development                 # development | production
LOG_LEVEL=debug                     # debug | info | warn | error

# Backend HTTP
API_PORT=8085
API_PUBLIC_URL=http://localhost:8085
WEB_PUBLIC_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Number of proxies in front of the API that append to X-Forwarded-For.
# 0 trusts nothing but the TCP peer. On Render, set 1.
TRUSTED_PROXY_HOPS=0
# Shared secret between the web app's server and the API. When the web app
# renders a page it calls the API on the visitor's behalf; with this set, it
# forwards the visitor's address so rate limits apply per visitor instead of to
# the web server as a whole. Server-side only: never prefix it NEXT_PUBLIC_.
# Generate with: openssl rand -base64 48
INTERNAL_PROXY_SECRET=

# Neon Postgres. The API uses the pooled connection string, and is meant to
# connect as a login role that inherits sardhana_app rather than as the owner —
# see docs/database.md#the-application-role. sslmode is required in production:
# the API refuses to start otherwise, because session digests and payout
# addresses cross this connection.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/sardhana?sslmode=require
# Direct (unpooled) string, used by migrations only: they take advisory locks
# and run DDL, neither of which survives the pooler.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/sardhana?sslmode=require
# Keep this well inside the pooler's own allowance for the plan.
DATABASE_MAX_CONNS=10

# Sessions. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-48-bytes-of-base64
SESSION_COOKIE_NAME=hustleon_session
# Set when the web app and the API are on sibling subdomains, e.g. hustleon.com
# and api.hustleon.com: use .hustleon.com so both can see the session. Leave
# empty for localhost, where cookies are already shared across ports.
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=720
MAGIC_LINK_TTL_MINUTES=15

# Resend transactional email.
# Leave empty in development: sign-in links are printed to the API log instead
# of being emailed. Required in production, where config.Load refuses to start
# without it.
RESEND_API_KEY=
EMAIL_FROM="Hustle On <login@mail.hustleon.com>"
EMAIL_REPLY_TO=support@hustleon.com

# Solana. Donations are plain transfers between wallets; there is no program to
# deploy, so the RPC endpoint and the cluster name are the whole configuration.
SOLANA_CLUSTER=devnet               # devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com

# Object storage for uploaded video (S3 compatible).
# Leave the credentials unset in development and the API stores uploads on disk
# under backend/data/uploads instead, so the flow works without a bucket.
STORAGE_ENDPOINT=
STORAGE_BUCKET=hustleon-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=2147483648         # 2 GiB
# Posters are fetched by every visitor to the feed, so they have a far
# smaller ceiling of their own: JPEG, PNG or WebP only (no SVG, which is a
# document that can carry script).
UPLOAD_POSTER_MAX_BYTES=8388608     # 8 MiB
UPLOAD_URL_TTL_MINUTES=15

# Rate limiting (requests per minute)
#
# Each endpoint is charged against a budget for its class of work rather than
# against one API-wide number, so the cheapest route to abuse (requesting a
# sign-in link, which sends mail) cannot run at the rate of the busiest one.
# See docs/api.md#rate-limits for the full table.
#
# RATE_LIMIT_ANON is the per-caller backstop around every route, and also the
# read budget: keyed by user id when signed in, by address when not.
# RATE_LIMIT_IP_CEILING is a looser per-address ceiling applied before the
# session is resolved, so one NAT is not throttled as one client.
# RATE_LIMIT_AUTH_ATTEMPTS is the sign-in and sign-in-token budget, charged to
# the address even when the caller is signed in.
RATE_LIMIT_ANON=300
RATE_LIMIT_AUTH_ATTEMPTS=5
RATE_LIMIT_IP_CEILING=1200
RATE_LIMIT_ENGAGE=60
RATE_LIMIT_WRITE=60
RATE_LIMIT_UPLOAD=10
# Poster uploads are admin-only and small, and an operator placing several
# in a row is normal, so they get their own budget rather than the video one.
RATE_LIMIT_POSTER=60
RATE_LIMIT_DONATE=10
RATE_LIMIT_ADMIN=240

# Frontend. Everything NEXT_PUBLIC_ is shipped to the browser, so nothing
# secret belongs here.
NEXT_PUBLIC_API_URL=http://localhost:8085
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SESSION_COOKIE=hustleon_session
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
