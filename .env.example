# ---------------------------------------------------------------------------
# Sardhana environment. Copy to .env and fill in. Never commit the filled file.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=development                 # development | staging | production
LOG_LEVEL=debug                     # debug | info | warn | error

# Backend HTTP
API_PORT=8085
API_PUBLIC_URL=http://localhost:8085
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Neon Postgres. Use the pooled connection string for the API.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/sardhana?sslmode=require
# Direct (unpooled) string, used by migrations only.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/sardhana?sslmode=require
DATABASE_MAX_CONNS=10

# Sessions and tokens. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-48-bytes-of-base64
SESSION_COOKIE_NAME=sardhana_session
SESSION_TTL_HOURS=720
MAGIC_LINK_TTL_MINUTES=15

# Resend transactional email.
# Leave empty in development: sign-in links are then printed to the API log
# instead of being emailed. Required in production, where config.Load refuses
# to start without it.
RESEND_API_KEY=
EMAIL_FROM="Sardhana <login@mail.sardhana.com>"
EMAIL_REPLY_TO=support@sardhana.com

# Solana
SOLANA_CLUSTER=devnet               # devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=Sard1111111111111111111111111111111111111111
PLATFORM_TREASURY=11111111111111111111111111111111
PLATFORM_FEE_BPS=250                # 2.50%

# Object storage for video originals and renditions (S3 compatible)
STORAGE_ENDPOINT=https://s3.region.amazonaws.com
STORAGE_BUCKET=sardhana-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_PUBLIC_BASE_URL=https://media.sardhana.com
UPLOAD_MAX_BYTES=2147483648         # 2 GiB
UPLOAD_URL_TTL_MINUTES=15

# Rate limiting (requests per minute)
RATE_LIMIT_ANON=60
RATE_LIMIT_USER=240
RATE_LIMIT_AUTH_ATTEMPTS=5
RATE_LIMIT_COMMENTS=20

# Frontend (Next.js public vars must stay non-secret)
NEXT_PUBLIC_API_URL=http://localhost:8085
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SESSION_COOKIE=hustler_on_session
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=Sard1111111111111111111111111111111111111111
